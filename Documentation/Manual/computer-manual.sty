\definecolor{listingnumberbg}{gray}{0.86}
\newdimen\listinggutterheight
\newdimen\listinggutterdepth
\newcommand{\listingnumbergutter}{%
  \begingroup
  % With framesep=0pt, exact strut dimensions fill the listing vertically
  % without entering the outer frame. Adjacent rows form one solid gutter.
  \listinggutterheight=\ht\strutbox
  \listinggutterdepth=\dp\strutbox
  \setlength{\fboxsep}{0pt}%
  \smash{%
    {\color{black}\vrule width 0.4pt height \listinggutterheight
      depth \listinggutterdepth}%
    \colorbox{listingnumberbg}{%
      \makebox[\dimexpr2em-0.4pt\relax][r]{%
        \vrule width 0.4pt height \listinggutterheight
          depth \listinggutterdepth}}}%
  \endgroup}
\newcommand{\listingnumberstyle}[1]{%
  \makebox[2em][r]{%
    \color{black}\tiny
    \BeginAccSupp{method=escape,ActualText={}}#1\EndAccSupp{}%
    \hspace{3pt}}}
\makeatletter
\lst@AddToHook{EveryLine}{%
  \llap{\listingnumbergutter\kern\lst@numbersep}}
\makeatother

