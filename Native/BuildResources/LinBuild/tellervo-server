function getWebserviceUrlCandidates($domain, $securehttp)
{
	$path = getInstanceWebPath();
	$hosts = array();

	$domain = trim((string) $domain);
	if($domain!="" && strpos($domain, "%")===false)
	{
		$hosts[] = $domain;
	}

	$ip = getIP();
	if($ip!="")
	{
		$hosts[] = $ip;
	}

	$hosts = array_values(array_unique($hosts));
	$schemes = $securehttp===TRUE ? array("https", "http") : array("http", "https");
	$urls = array();
	foreach($schemes as $scheme)
	{
		foreach($hosts as $host)
		{
			$urls[] = $scheme."://".$host.$path;
		}
	}

	return array_values(array_unique($urls));
}

function isWebserviceUrlReachable($url)
{
	$context = stream_context_create(array(
		"http" => array("timeout" => 5),
		"ssl" => array(
			"verify_peer" => false,
			"verify_peer_name" => false
		)
	));

	$handle = @fopen($url, "r", false, $context);
	if($handle===FALSE)
	{
		return false;
	}

	fclose($handle);
	return true;
}

function findReachableWebserviceUrl($urls)
{
	foreach($urls as $url)
	{
		if(isWebserviceUrlReachable($url))
		{
			return $url;
		}
	}

	return false;
}

