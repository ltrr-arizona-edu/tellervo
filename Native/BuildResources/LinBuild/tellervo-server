function detectPostgresVersion()
{
	$versions = array();

	foreach (glob('/etc/postgresql/*', GLOB_ONLYDIR) as $dir)
	{
		$basename = basename($dir);
		if (preg_match('/^\d+$/', $basename))
		{
			$versions[] = (int) $basename;
		}
	}

	if (!empty($versions))
	{
		sort($versions, SORT_NUMERIC);
		return (string) end($versions);
	}

	exec("pg_config --version 2>/dev/null", $output, $retcode);
	if ($retcode === 0 && !empty($output[0]) && preg_match('/(\d+)/', $output[0], $matches))
	{
		return $matches[1];
	}

	return "17";
}

function detectPostgisFolder($postgresversion)
{
	$candidates = glob("/usr/share/postgresql/".$postgresversion."/contrib/postgis-*", GLOB_ONLYDIR);

	if($candidates!==false)
	{
		rsort($candidates, SORT_NATURAL);
		foreach($candidates as $candidate)
		{
			$path = rtrim($candidate, "/")."/";
			if(file_exists($path."postgis.sql") && file_exists($path."spatial_ref_sys.sql") && file_exists($path."legacy.sql"))
			{
				return $path;
			}
		}
	}

	return "/usr/share/postgresql/".$postgresversion."/contrib/postgis-3/";
}

