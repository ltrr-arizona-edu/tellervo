    die("PostgreSQL username cannot be empty.\n");
  }

  $contents = "username=".$username."\npassword=".$password."\n";
  if(file_put_contents($credentialsFile, $contents, LOCK_EX)===FALSE)
  {
    die("Unable to write PostgreSQL credentials file.\n");
  }

  chmod($credentialsFile, 0600);
  exec("chown www-data ".escapeshellarg($credentialsFile));
}

function normaliseCredentialValue($value)
{
  $value = trim($value, " \t\n\r\0\x0B");
  while(substr($value, 0, 1)=="=")
  {
    $value = substr($value, 1);
    $value = ltrim($value, " \t\n\r\0\x0B");
  }

  return $value;
}

/**
 * Read a simple key=value credentials file.
 */
function readCredentialsFile($filename)
{
  $credentials = array();
  foreach(file($filename, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES) as $line)
  {
    $parts = explode("=", $line, 2);
    if(count($parts)==2)
    {
      $credentials[trim($parts[0])] = normaliseCredentialValue($parts[1]);
    }
  }

  return $credentials;
}

/**
 * Create or update the configured PostgreSQL role and password.
 */
function applyDatabaseUserPermissions()
{
  global $logfile;
  global $permsfile;
  global $permstemplate;
  global $user;
  global $pwd;

  copy($permstemplate, $permsfile);

  $snr = new File_SearchReplace("%%DBUSER%%",
                          trim($user, "\n\r"),
                          $permsfile,
                          '', // directorie(s) to search
                          false) ;
  $snr->doSearch();
  $snr = new File_SearchReplace("%%DBPWD%%",
                          sqlLiteral(trim($pwd, "\n\r")),
                          $permsfile,
                          '', // directorie(s) to search
                          false) ;
  $snr->doSearch();

  exec("su - postgres -c \"psql --file=".escapeshellarg($permsfile)." 2>> ".$logfile."\"", $output, $returnvar);
  if($returnvar!=0)
  {
    echo "Unable to apply PostgreSQL database permissions.  See ".$logfile." for details.\n";
    exit(1);
  }
}

/**
 * Escape a value that will be inserted into a SQL single-quoted literal.
 */
function sqlLiteral($value)
{
  return str_replace("'", "''", $value);
}

