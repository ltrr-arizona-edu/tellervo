/**
 * Get the IP address of this computer
 */
function getIP()
{
  exec("hostname -I | awk '{print $1}'", $response);
  
  return $response[0];
}

function isLocalPostgresHost($host)
{
  $host = strtolower(trim($host));
  return $host=="" || $host=="localhost" || $host=="127.0.0.1" || $host=="::1";
}

