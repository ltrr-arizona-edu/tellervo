function normaliseInstanceName($name)
{
	$name = trim($name);
	if(!preg_match('/^[A-Za-z0-9][A-Za-z0-9_.-]*$/', $name))
	{
		echo "Invalid instance name '$name'. Use letters, numbers, dots, dashes or underscores.\n";
		exit(1);
	}

	return $name;
}

function getDefaultInstanceConfig($name)
{
	return array(
		"name" => $name,
		"dbname" => "tellervo_".str_replace(array(".", "-"), "_", strtolower($name)),
		"webfolder" => "/var/www/".$name."/"
	);
}

function getClusterInstances()
{
	global $clusterConfigFile;
	$instances = array();

	if(!file_exists($clusterConfigFile))
	{
		return $instances;
	}

	$lines = file($clusterConfigFile, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);
	foreach($lines as $line)
	{
		$line = trim($line);
		if($line=="" || substr($line, 0, 1)=="#")
		{
			continue;
		}

		$parts = preg_split('/\s+/', $line, 3);
		if(count($parts)!=3)
		{
			continue;
		}

		$name = normaliseInstanceName($parts[0]);
		$webfolder = $parts[2];
		if(substr($webfolder, -1)!="/") $webfolder = $webfolder."/";
		$instances[$name] = array("name" => $name, "dbname" => $parts[1], "webfolder" => $webfolder);
	}

	return $instances;
}

function getInstanceConfig($name)
{
	$instances = getClusterInstances();
	if(isset($instances[$name]))
	{
		return $instances[$name];
	}

	return false;
}

function registerCurrentInstance()
{
	global $clusterConfigFile;
	global $instanceName;
	global $dbname;
	global $wsbase;

	if($instanceName=="")
	{
		return;
	}

	$instances = getClusterInstances();
	$instances[$instanceName] = array("name" => $instanceName, "dbname" => $dbname, "webfolder" => $wsbase);
	writeClusterInstances($instances);
}

function getInstanceWebPath($webfolder=null)
{
	global $wsbase;
	$folder = $webfolder===null ? $wsbase : $webfolder;
	$folder = rtrim($folder, "/");
	$name = basename($folder);

	if($name=="tellervo")
	{
		return "/";
	}

	return "/".$name."/";
}

function writeApacheInstancesConfig()
{
	global $apacheInstancesConfig;
	global $instanceName;
	global $dbname;
	global $wsbase;
	global $logfile;

	$instances = getClusterInstances();
	if($instanceName!="")
	{
		$instances[$instanceName] = array("name" => $instanceName, "dbname" => $dbname, "webfolder" => $wsbase);
	}

	if(empty($instances))
	{
		$contents = "# Generated by tellervo-server.  Named instances are served below the default host.\n";
		file_put_contents($apacheInstancesConfig, $contents);
		exec("a2enconf tellervo-instances.conf 2>> $logfile", $response);
		return;
	}

	$contents = "# Generated by tellervo-server.  Named instances are served below the default host.\n";
	foreach($instances as $instance)
	{
		$webfolder = rtrim($instance["webfolder"], "/");
		$path = "/".$instance["name"]."/";
		if($path=="/")
		{
			continue;
		}

		$contents .= "\nAlias ".$path." ".$webfolder."/\n";
		$contents .= "<Directory ".$webfolder."/>\n";
		$contents .= "    Options Indexes FollowSymLinks MultiViews\n";
		$contents .= "    AllowOverride None\n";
		$contents .= "    Require all granted\n";
		$contents .= "</Directory>\n";
	}

	file_put_contents($apacheInstancesConfig, $contents);
	exec("a2enconf tellervo-instances.conf 2>> $logfile", $response);
}

function writeClusterInstances($instances)
{
	global $clusterConfigFile;
	global $logfile;

	ksort($instances);

	$folder = dirname($clusterConfigFile);
	if(!file_exists($folder))
	{
		if(!mkdir($folder, 0755, true) && !file_exists($folder))
		{
			echo "Unable to create instance registry folder: ".$folder."\n";
			writeLogMsg("Unable to create instance registry folder: ".$folder, "ERROR");
			return false;
		}
	}

	$contents = "# Tellervo server instances\n";
	$contents .= "# name dbname webfolder\n";
	foreach($instances as $instance)
	{
		$contents .= $instance["name"]." ".$instance["dbname"]." ".$instance["webfolder"]."\n";
	}

	if(file_put_contents($clusterConfigFile, $contents, LOCK_EX)===FALSE)
	{
		echo "Unable to write instance registry: ".$clusterConfigFile."\n";
		writeLogMsg("Unable to write instance registry: ".$clusterConfigFile, "ERROR");
		return false;
	}

	chmod($clusterConfigFile, 0644);
	return true;
}

function isSafeInstanceWebFolder($webfolder)
{
	$folder = rtrim($webfolder, "/");
	$unsafe = array("", "/", "/var", "/var/www", "/var/www/tellervo");

	if(in_array($folder, $unsafe))
	{
		return false;
	}

	if(strpos($folder, "..")!==false)
	{
		return false;
	}

	return strlen($folder) > strlen("/var/www/");
}

function deleteFolderTree($path)
{
	$path = rtrim($path, "/");
	if(!file_exists($path) && !is_link($path))
	{
		return true;
	}

	if(!isSafeInstanceWebFolder($path))
	{
		echo "Refusing to delete unsafe web folder path: $path\n";
		return false;
	}

	if(is_link($path) || is_file($path))
	{
		return unlink($path);
	}

	$items = scandir($path);
	if($items===false)
	{
		return false;
	}

	foreach($items as $item)
	{
		if($item=="." || $item=="..")
		{
			continue;
		}

		$child = $path."/".$item;
		if(is_dir($child) && !is_link($child))
		{
			if(!deleteFolderTree($child))
			{
				return false;
			}
		}
		else
		{
			if(!unlink($child))
			{
				return false;
			}
		}
	}

	return rmdir($path);
}

function conventionalInstanceRole($name)
{
	return "tellervo_".preg_replace('/[^a-z0-9_]/', '_', strtolower($name));
}

function canUseDialog()
{
	return function_exists("posix_isatty")
		&& posix_isatty(STDIN)
		&& trim(shell_exec("command -v dialog 2>/dev/null"))!="";
}

function dialogYesNo($title, $message, $height=20, $width=74)
{
	if(!canUseDialog())
	{
		return null;
	}

	$dialog = new Tui();
	$cmd = "dialog --backtitle ".escapeshellarg("Tellervo Server Configuration")
		." --title ".escapeshellarg($title)
		." --yesno ".escapeshellarg($message)
		." ".$height." ".$width;
	$dialog->processStart($cmd);
	$dialog->processStop();

	return $dialog->getReturnCode()===0;
}

function dialogInput($title, $message, $height=12, $width=74)
{
	if(!canUseDialog())
	{
		return null;
	}

	$dialog = new Tui();
	$cmd = "dialog --backtitle ".escapeshellarg("Tellervo Server Configuration")
		." --title ".escapeshellarg($title)
		." --inputbox ".escapeshellarg($message)
		." ".$height." ".$width;
	$dialog->processStart($cmd);
	$dialog->processStop();

	if($dialog->getReturnCode()!==0)
	{
		return false;
	}

	return trim($dialog->getPipeTwo());
}

function confirmDeleteInstance($name, $dbname, $webfolder, $credentialsFile, $clusterConfigFile, $role)
{
	$warning = "DANGER: this will permanently delete a Tellervo server instance.\n\n"
		."There is no undo. Make a backup before continuing.\n\n"
		."Instance name:\n  ".$name."\n\n"
		."Database to drop:\n  ".$dbname."\n\n"
		."Web folder to remove:\n  ".$webfolder."\n\n"
		."Credentials file:\n  ".$credentialsFile."\n\n"
		."Registry file:\n  ".$clusterConfigFile."\n\n"
		."DB role to drop if it exists:\n  ".$role."\n\n"
		."The shared/default 'tellervo' database user will not be removed.\n\n"
		."Continue?";

	$dialogResponse = dialogYesNo("Delete Tellervo Instance", $warning, 28, 78);
	if($dialogResponse!==null)
	{
		if($dialogResponse!==true)
		{
			echo "\nInstance was not deleted.\n\n";
			exit(1);
		}

		$response = dialogInput("Confirm Instance Name", "Type the instance name exactly to continue:\n\n".$name, 12, 70);
		if($response===false || $response!==$name)
		{
			echo "\nConfirmation did not match.  Instance was not deleted.\n\n";
			exit(1);
		}

		$response = dialogInput("Final Confirmation", "Last chance.\n\nType DELETE to permanently delete '".$name."':", 12, 70);
		if($response===false || $response!=="DELETE")
		{
			echo "\nConfirmation did not match.  Instance was not deleted.\n\n";
			exit(1);
		}

		return;
	}

	echo "\n";
	echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!\n";
	echo "DANGER: this will permanently delete a Tellervo server instance.\n";
	echo "There is no undo.  Make a backup before continuing.\n";
	echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!\n\n";
	echo "Instance name       : ".$name."\n";
	echo "Database to drop    : ".$dbname."\n";
	echo "Web folder to remove: ".$webfolder."\n";
	echo "Credentials file    : ".$credentialsFile."\n";
	echo "Registry file       : ".$clusterConfigFile."\n";
	echo "DB role to drop     : ".$role." (if it exists)\n\n";
	echo "The shared/default 'tellervo' database user will not be removed.\n\n";

	echo "To confirm deletion, type the instance name exactly: ";
	$response = trim(fgets(STDIN));
	if($response!==$name)
	{
		echo "\nConfirmation did not match.  Instance was not deleted.\n\n";
		exit(1);
	}

	echo "\nLast chance. Type DELETE to permanently delete '$name': ";
	$response = trim(fgets(STDIN));
	if($response!=="DELETE")
	{
		echo "\nConfirmation did not match.  Instance was not deleted.\n\n";
		exit(1);
	}
}

function deleteInstance($name)
{
	global $clusterConfigFile;
	global $folderbase;
	global $instanceName;
	global $logfile;

	$name = normaliseInstanceName($name);
	$instances = getClusterInstances();

	if(!isset($instances[$name]))
	{
		echo "\nNo registered Tellervo instance named '$name'.\n";
		echo "Registered instances can be shown with: tellervo-server --list-instances\n\n";
		exit(1);
	}

	$instance = $instances[$name];
	$dbnameToDelete = $instance["dbname"];
	$webfolderToDelete = rtrim($instance["webfolder"], "/");
	$credentialsToDelete = $folderbase."server_credentials.".$name;
	$roleToDelete = conventionalInstanceRole($name);

	if($dbnameToDelete=="tellervo" || rtrim($webfolderToDelete, "/")=="/var/www/tellervo")
	{
		echo "\nRefusing to delete the default Tellervo instance with --delete-instance.\n\n";
		exit(1);
	}

	if(!isSafeInstanceWebFolder($webfolderToDelete))
	{
		echo "Refusing to continue because the registered web folder looks unsafe:\n";
		echo "  ".$webfolderToDelete."\n\n";
		exit(1);
	}

	confirmDeleteInstance($name, $dbnameToDelete, $webfolderToDelete, $credentialsToDelete, $clusterConfigFile, $roleToDelete);

	echo "\nDropping PostgreSQL database '$dbnameToDelete'...\n";
	exec("su - postgres -c ".escapeshellarg("dropdb --if-exists ".escapeshellarg($dbnameToDelete))." 2>> ".escapeshellarg($logfile), $output, $returnvar);
	if($returnvar!=0)
	{
		echo "Unable to drop database '$dbnameToDelete'.  Stop any active connections and try again.\n";
		exit(1);
	}

	echo "Dropping PostgreSQL role '$roleToDelete' if it exists...\n";
	exec("su - postgres -c ".escapeshellarg("dropuser --if-exists ".escapeshellarg($roleToDelete))." 2>> ".escapeshellarg($logfile), $output, $returnvar);
	if($returnvar!=0)
	{
		echo "Warning: unable to drop role '$roleToDelete'.  Continuing with instance cleanup.\n";
	}

	if(file_exists($credentialsToDelete))
	{
		echo "Removing credentials file...\n";
		if(!unlink($credentialsToDelete))
		{
			echo "Warning: unable to remove credentials file '$credentialsToDelete'.\n";
		}
	}

	echo "Removing web folder...\n";
	if(!deleteFolderTree($webfolderToDelete))
	{
		echo "Unable to remove web folder '$webfolderToDelete'.  Registry was not changed.\n";
		exit(1);
	}

	unset($instances[$name]);
	writeClusterInstances($instances);
	$instanceName = "";
	writeApacheInstancesConfig();

	echo "Reloading Apache...\n";
	exec("service apache2 reload 2>> ".escapeshellarg($logfile));

	echo "\nInstance '$name' has been deleted.\n\n";
}

function linkIfMissing($source, $destination)
{
	if(is_link($destination))
	{
		if(readlink($destination)==$source)
		{
			return;
		}

		unlink($destination);
	}
	else if(file_exists($destination))
	{
		$backup = rtrim($destination, "/").".old-".date("YmdHis");
		if(!rename($destination, $backup))
		{
			echo "Unable to move existing web asset out of the way:\n";
			echo "  ".$destination."\n\n";
			exit(1);
		}

		echo "Moved existing web asset to ".$backup."\n";
	}

	if(!symlink($source, $destination))
	{
		echo "Unable to create web asset link:\n";
		echo "  ".$destination." -> ".$source."\n\n";
		exit(1);
	}
}

function ensureFolderExists($folder)
{
	if(is_link($folder))
	{
		return;
	}

	if(!file_exists($folder))
	{
		mkdir($folder, 0755, true);
	}
}

function writePhpForwarder($source, $destination, $workingDirectory=null)
{
	if($workingDirectory===null)
	{
		$workingDirectory = dirname($destination);
	}

	$contents = "<?php\n"
		."// Generated by tellervo-server for named instance web folders.\n"
		."chdir(".var_export($workingDirectory, true).");\n"
		."require ".var_export($source, true).";\n";

	if(is_link($destination))
	{
		unlink($destination);
	}
	else if(file_exists($destination))
	{
		$existing = file_get_contents($destination);
		if($existing===$contents)
		{
			return;
		}

		if(strpos($existing, "Generated by tellervo-server for named instance web folders.")===false)
		{
			$backup = rtrim($destination, "/").".old-".date("YmdHis");
			if(!rename($destination, $backup))
			{
				echo "Unable to move existing web entrypoint out of the way:\n";
				echo "  ".$destination."\n\n";
				exit(1);
			}

			echo "Moved existing web entrypoint to ".$backup."\n";
		}
	}

	if(file_put_contents($destination, $contents)===FALSE)
	{
		echo "Unable to create web entrypoint:\n";
		echo "  ".$destination."\n\n";
		exit(1);
	}

	chmod($destination, 0644);
}

function prepareWebFolder()
{
	global $wsbase;

	$defaultWebFolder = "/var/www/tellervo/";
	if(rtrim($wsbase, "/")==rtrim($defaultWebFolder, "/"))
	{
		return;
	}

	if(!file_exists($defaultWebFolder))
	{
		echo "Default webservice folder $defaultWebFolder is missing.  Cannot create instance web folder.\n";
		exit(1);
	}

	ensureFolderExists($wsbase);
	ensureFolderExists($wsbase."odk");
	ensureFolderExists($wsbase."odk/inc");

	linkIfMissing($defaultWebFolder."inc", $wsbase."inc");
	linkIfMissing($defaultWebFolder."css", $wsbase."css");
	linkIfMissing($defaultWebFolder."img", $wsbase."img");
	linkIfMissing($defaultWebFolder."jscript", $wsbase."jscript");
	linkIfMissing($defaultWebFolder."schemas", $wsbase."schemas");
	linkIfMissing($defaultWebFolder."scripts", $wsbase."scripts");
	writePhpForwarder($defaultWebFolder."index.php", $wsbase."index.php");
	writePhpForwarder($defaultWebFolder."post.php", $wsbase."post.php");

	linkIfMissing($defaultWebFolder."odk/.htaccess", $wsbase."odk/.htaccess");
	writePhpForwarder($defaultWebFolder."odk/deleteFormDefinitions.php", $wsbase."odk/deleteFormDefinitions.php");
	writePhpForwarder($defaultWebFolder."odk/deleteFormInstances.php", $wsbase."odk/deleteFormInstances.php");
	writePhpForwarder($defaultWebFolder."odk/deleteSpecificFormDefinition.php", $wsbase."odk/deleteSpecificFormDefinition.php");
	writePhpForwarder($defaultWebFolder."odk/deleteSpecificFormInstance.php", $wsbase."odk/deleteSpecificFormInstance.php");
	writePhpForwarder($defaultWebFolder."odk/fetchInstances.php", $wsbase."odk/fetchInstances.php");
	writePhpForwarder($defaultWebFolder."odk/formList.php", $wsbase."odk/formList.php");
	writePhpForwarder($defaultWebFolder."odk/forms.php", $wsbase."odk/forms.php");
	writePhpForwarder($defaultWebFolder."odk/index.php", $wsbase."odk/index.php");
	writePhpForwarder($defaultWebFolder."odk/mediafile.php", $wsbase."odk/mediafile.php");
	writePhpForwarder($defaultWebFolder."odk/odkauth.php", $wsbase."odk/odkauth.php");
	writePhpForwarder($defaultWebFolder."odk/odkhelper.php", $wsbase."odk/odkhelper.php");
	writePhpForwarder($defaultWebFolder."odk/submission.php", $wsbase."odk/submission.php");
	linkIfMissing($defaultWebFolder."odk/inc/odkauth.php", $wsbase."odk/inc/odkauth.php");
	linkIfMissing($defaultWebFolder."odk/inc/odkhelper.php", $wsbase."odk/inc/odkhelper.php");
}

function repairWebAssets()
{
	global $wsbase;
	global $instanceName;
	global $clusterConfigFile;
	global $logfile;

	$instances = getClusterInstances();
	$legacyInstancesFolder = "/var/www/tellervo-servers";
	if(file_exists($legacyInstancesFolder) && is_dir($legacyInstancesFolder))
	{
		$legacyFolders = scandir($legacyInstancesFolder);
		if($legacyFolders!==false)
		{
			foreach($legacyFolders as $folder)
			{
				if($folder=="." || $folder=="..")
				{
					continue;
				}

				$legacyWebFolder = $legacyInstancesFolder."/".$folder;
				if(!is_dir($legacyWebFolder) || is_link($legacyWebFolder))
				{
					continue;
				}

				$name = normaliseInstanceName($folder);
				if(!isset($instances[$name]))
				{
					$instances[$name] = array("name" => $name, "dbname" => $name, "webfolder" => $legacyWebFolder."/");
				}
			}
		}
	}

	if(empty($instances))
	{
		echo "No named Tellervo instances are registered in $clusterConfigFile.\n";
		echo "No legacy instance folders were found under /var/www/tellervo-servers.\n";
		return;
	}

	foreach($instances as $instance)
	{
		$instanceName = $instance["name"];
		$wsbase = $instance["webfolder"];
		if(substr($wsbase, -1)!="/")
		{
			$wsbase = $wsbase."/";
		}

		echo "Repairing web assets for instance '".$instanceName."'...\n";
		prepareWebFolder();
	}

	writeApacheInstancesConfig();
	exec("service apache2 reload 2>> ".escapeshellarg($logfile));
	echo "Web assets repaired.\n";
}

function printInstances()
{
	$instances = getClusterInstances();
	echo "\nTellervo server instances\n\n";

	if(empty($instances))
	{
		echo "No instances are registered yet.\n";
		echo "Create one with: tellervo-server --instance NAME --configure\n\n";
		return;
	}

	foreach($instances as $instance)
	{
		echo "  ".$instance["name"]."\n";
		echo "    Database  : ".$instance["dbname"]."\n";
		echo "    Web folder: ".$instance["webfolder"]."\n";
	}
	echo "\n";
}

function runClusterCommand($clusterCommand)
{
	global $clusterConfigFile;

	$allowedCommands = array("test", "sysconfig", "upgrade-db", "version", "info", "emptylog", "network");
	if(!in_array($clusterCommand, $allowedCommands))
	{
		echo "Unsupported cluster command '$clusterCommand'.\n";
		echo "Supported commands: ".implode(", ", $allowedCommands)."\n";
		exit(1);
	}

	$instances = getClusterInstances();
	if(empty($instances))
	{
		echo "No Tellervo instances are registered in $clusterConfigFile.\n";
		exit(1);
	}

	$overallReturn = 0;
	foreach($instances as $instance)
	{
		echo "\n=== ".$instance["name"]." ===\n";
		$cmd = PHP_BINARY." ".escapeshellarg(__FILE__)." --cluster-config ".escapeshellarg($clusterConfigFile)." --instance ".escapeshellarg($instance["name"])." --".$clusterCommand;
		passthru($cmd, $return);
		if($return!=0)
		{
			$overallReturn = $return;
		}
	}

	exit($overallReturn);
}



function backupDB($dbfilename)
{
	global $dbname;

	echo "Backing up database...\n";
	exec("pg_dump -Fc -U tellervo ".$dbname." > ".$dbfilename, $output, $returnvar);
	if($returnvar>=2)
	{
		echo "Backup failed";
		exit($returnvar);
	}
	else
	{
		echo "Database successfully backed up to '".$dbfilename."'\n";
	}

	return true;
}

/**
 * Restore a previously created database dump.  File needs to have been created with 'pg_dump -Fc'.
 * PostGIS, PLJava and any database upgrade patches will be applied to bring the database up to
 * the current version.
 *
 * @param unknown $dbfilename
 */
function restoreDB($dbfilename)
{
	global $postgisfolder;
	global $dbconn;
	global $logfile;
	global $dbsetupfile;
	global $upgradeScripts;
	global $dbname;
	global $systemconfig;

	if(!is_readable($dbfilename)) {
		echo "Specified database backup file '$dbfilename' does not exist\n";
		exit(0);
	}

	if(!is_writeable($dbfilename)) {
		echo "Database backup file is not in a writeable folder.\n";
		echo "Try copying into '/tmp/' and try again.\n";
		exit(0);
	}

	echo "\nThis procedure will overwrite any existing Tellervo database.\nAre you sure you want to continue?\n";
	echo "   (y/N): ";
	$response = trim(fgets(STDIN));
	if($response!="Y" && $response !="y")
	{
		exit(0);
	}


	$postgisrestore = $postgisfolder."postgis_restore.pl";
	$postgissql = $postgisfolder."postgis.sql";
	$postgisspatialrefsys = $postgisfolder."spatial_ref_sys.sql";
	$postgislegacy = $postgisfolder."legacy.sql";

	if(!file_exists($postgisfolder) || !file_exists($postgissql)
			|| !file_exists($postgisspatialrefsys) || !file_exists($postgislegacy)){
		echo "Unable to find PostGIS upgrade files\n";
		exit(0);
	}

	// Check if tellervo database exists.  If it does then check about deleting it
	if(doesTellervoDBExist() === false)
	{
		// Tellervo database doesn't currently exist
	}
	else
	{
		// Tellervo database DOES exist
		pg_close($dbconn);
		echo"\nDeleting existing database...\n";
		exec("su - postgres -c \"dropdb ".$dbname."\"", $output, $returnvar);
		if($returnvar>=1) {
			echo "\nUnable to restore database until existing database is removed.\n";
			echo "Please ensure all database connections are closed, then try again.\n";
			die();
		}
	}


	echo "\nCreating database...\n";
	exec("su - postgres -c \"createdb ".$dbname." 2>> ".$logfile."\"");
	echo "\nApplying PostGIS upgrade patches...\n";
    exec("su - postgres -c \"psql -d ".$dbname." -f ".$postgissql." 2>> ".$logfile."\"");
    exec("su - postgres -c \"psql -d ".$dbname." -f ".$postgisspatialrefsys." 2>> ".$logfile."\"");
    exec("su - postgres -c \"psql -d ".$dbname." -f ".$postgislegacy." 2>> ".$logfile."\"");
    echo "\nConfiguring PLJava extension.\n";
    exec("su - postgres -c \"psql -d ".$dbname." -f ".$upgradeScripts."/database_upgrade-1.3.0e.notransaction.sql 2>> ".$logfile."\"");
    echo "\nApplying PostGIS upgrade patches.  This could take some time on larger databases...\n";
    if(file_exists($postgisrestore))
    {
		shell_exec("su - postgres -c \"".$postgisrestore." ".$dbfilename." | psql ".$dbname." 2>> ".$logfile."\"");
    }
    else
    {
		exec("su - postgres -c \"pg_restore --dbname=".$dbname." ".$dbfilename." 2>> ".$logfile."\"");
    }
    echo "\nFinalising PLJava extension configuration...\n";

	include($dbsetupfile);
    echo "\nRegenerating systems config file\n";
    generateSystemsConfig();
	include($systemconfig);

	// Now insert record into upgradelog so patch that was already run won't be re-run
	$sql = "INSERT into tblupgradelog (filename) VALUES ('database_upgrade-1.3.0e.notransaction.sql');";
	$result = pg_query($dbconn, $sql);
	if(!$result)
	{
		writeLogMsg("Unable to add patch name to upgradelog" );
	}

	// Run remaining upgrade patches
    runDBUpgrades(true);
   	return;

}

